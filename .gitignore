# Built application files
*.apk
*.aar
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
release/

# Gradle files
.gradle/
build/

# Local configuration file (sdk path, etc)
local.properties

# Environment variables
.env

# Proguard folder generated by Eclipse
proguard/

# R8 mapping file copy (for Play Console upload)
release-outputs/

# Log Files
*.log

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# IntelliJ
*.iml
.idea/workspace.xml
.idea/tasks.xml
.idea/gradle.xml
.idea/assetWizardSettings.xml
.idea/dictionaries
.idea/libraries
.idea/jarRepositories.xml
.idea/caches
.idea/modules.xml
.idea/navEditor.xml

# Keystore files
key.properties
*.jks
*.keystore


# External native build folder generated in Android Studio 2.2 and later
.externalNativeBuild
.cxx/

# Google Services (e.g. APIs or Firebase)
# Not google-services.json: this project applies the
# com.google.gms.google-services Gradle plugin, which fails the build when the
# file is absent. It holds the project identifiers that ship inside the app
# anyway, which is why hiding it protected nothing.

# Freeline
freeline.py
freeline/
freeline_project_description.json

# fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots
fastlane/test_output
fastlane/readme.md

# Version control
vcs.xml

# lint
lint/intermediates/
lint/generated/
lint/outputs/
lint/tmp/

# Android Profiling
*.hprof

# Mac
.DS_Store
.kotlin/

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Workspace tooling, not part of this app. Six of the other repos already
# hide it; keeping one set of rules means the same review applies everywhere.
.claude/
.cursorignore

# --- Signing assets (added 2026-09-06) ---
# None of these are in any repository today. The rules exist so that a
# certificate exported to the project directory for a one-off cannot be
# committed by a later `git add -A`. Distribution certificates and the App
# Store Connect key grant publishing rights, and a leak is not fixed by
# deleting the file: the history keeps it.
*.p12
*.p8
*.cer
*.certSigningRequest
*.mobileprovision
*.provisionprofile
.idea/markdown.xml
