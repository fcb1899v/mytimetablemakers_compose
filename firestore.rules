rules_version = '2';

// One Firebase project serves this app and mytimetablemaker_swiftui, so the rules live only here and deploy from this directory.
// Sign-in is email and password on both platforms, so the uid identifies a person and binding every path to it is the whole protection.

service cloud.firestore {
  match /databases/{database}/documents {

    // Neither app integrates App Check as of 2026-09-06, so these rules have to stand on their own.
    match /users/{uid} {
      allow read: if isOwner(uid);

      // Neither app deletes a document, so adding deletion has to be a deliberate edit here.
      allow create, update: if isOwner(uid);
      allow delete: if false;

      // goorback/{goorback}/timetable/{timetableNTag} hang off the owner's document (FirestoreViewModel.kt, FirestoreViewModel.swift), so one recursive match covers them and later additions.
      match /{document=**} {
        allow read, write: if isOwner(uid);
      }
    }

    // Rules do not cascade, so this explicit deny makes a later broad match remove it on purpose.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

function isOwner(uid) {
  return request.auth != null && request.auth.uid == uid;
}

// No size guard because a timetable document holds a variable number of departure times, so a cap guessed from outside would deny real writes.
// Add one only once the shape is measured.
